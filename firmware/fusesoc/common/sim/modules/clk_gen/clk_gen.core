CAPI=2:
name: qick:common:clk_gen:0.1.0
description: clock generator with configurable frequency, phase and duty cycle intended for simulations

filesets:
  hdl:
    files:
      - hdl/clk_gen.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - hdl

  lint:
    <<: *default
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
