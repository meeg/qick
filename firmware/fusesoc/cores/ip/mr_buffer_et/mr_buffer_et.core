CAPI=2:
name: qick:ip:mr_buffer_et:1.2.0
description: Multi-Rate (MR) Buffer with external trigger.

filesets:
  hdl:
    files:
      - hdl/mr_buffer_et.sv
    file_type: systemVerilogSource
    depend:
      - qick:axi:axil_slv
      - qick:mem:mr_buffer

  tb:
    files:
      - test/mr_buffer_et_tc00.sv
      - test/mr_buffer_et_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:interfaces:axi4_lite_if
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
      test_files:
        - test/mr_buffer_et_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: mr_buffer_et

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: mr_buffer_et
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      modelsim:
        vlog_options: [-timescale=1ns/1ns -L xpm]              # XPM library
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012

  synth:
    <<: *default
    description: Synthesize the design
    default_tool: vivado
    tools:
      vivado:
        part: xc7z020clg400-1
    parameters:
      - N
      - B

  package:
    description: Package IP for Vivado IP Catalog
    filesets: [hdl]
    toplevel: mr_buffer_et
    generate: [mr_buffer_et_packager_gen]
