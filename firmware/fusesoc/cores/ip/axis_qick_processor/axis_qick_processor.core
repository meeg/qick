CAPI=2:
name: qick:ip:axis_qick_processor:1.0.0
description: "QICK AXI4-Stream Timed Processor v2 (axis_qick_processor) IP core"

filesets:
  hdl:
    files:
      - hdl/axis_qick_processor.sv
    file_type: systemVerilogSource
    depend:
      - qick:ip:axis_qick_processor_regmap
      - qick:interfaces:axi4_lite_if
      - qick:cdc:cdc_reg_sync
      - qick:processors:qick_processor

  constraints:
    files:
      - constraints/axis_qick_processor.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_qick_processor_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_qick_processor_tc00.sv
      - tests/axis_qick_processor_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:xilinx
      - qick:common:sim_base
      - qick:interfaces:axi4_lite_if

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_qick_processor_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_qick_processor

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_qick_processor
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM -top work.glbl -timescale=1ns/1ps]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

  synth:
    <<: *default
    description: OOC Synthesis with Vivado (validate RTL + packages)
    default_tool: vivado
    tools:
      vivado:
        part: xczu49dr-ffvf1760-2-e
        pnr: none
