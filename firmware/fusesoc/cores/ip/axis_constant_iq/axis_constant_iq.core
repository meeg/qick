CAPI=2:
name: qick:ip:axis_constant_iq:1.0.0
description: AXIS Constant IQ IP core

filesets:
  hdl:
    files:
      - hdl/axis_constant_iq.sv
    file_type: systemVerilogSource
    depend:
      - qick:axi:axil_slv
      - qick:cdc:sync_nxm
      - qick:ip:axis_constant_iq_regmap

  tb:
    files:
      - tests/axis_constant_iq_tc00.sv
      - tests/axis_constant_iq_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:interfaces:axi4_lite_if
      - qick:interfaces:axi4_stream_if
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/axis_constant_iq_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_constant_iq

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_constant_iq
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]


  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      icarus:
        iverilog_options:
          - -g2012
      modelsim:
        vlog_options:
          - -timescale=1ns/1ns

