CAPI=2:
name: qick:ip:axis_signal_gen_v4:1.0.0
description: axis_signal_gen_v4 IP core

filesets:
  hdl:
    files:
      - hdl/axis_signal_gen_v4.sv
    file_type: systemVerilogSource
    depend:
      - qick:cdc:sync_nxm
      - qick:axi:axil_slv
      - qick:dsp:sgv4_top

  constraints:
    files:
      - constraints/axis_signal_gen_v4.xdc: {file_type: xdc}
    file_type: xdc

  constraints_ooc:
    files:
      - constraints/axis_signal_gen_v4_ooc.xdc: {file_type: xdc}
    file_type: xdc

  tb:
    files:
      - tests/axis_signal_gen_v4_tc00.sv
      - tests/axis_signal_gen_v4_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/axis_signal_gen_v4_tc00.sv

targets:
  default: 
    filesets: [hdl]
    toplevel: axis_signal_gen_v4

  lint:
    filesets: [hdl, lint_files]
    toplevel: axis_signal_gen_v4
    default_tool: veriblelint
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    description: Simulate the design
    filesets: [hdl, tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
  synth:
    filesets: [hdl, constraints]
    default_tool: vivado
