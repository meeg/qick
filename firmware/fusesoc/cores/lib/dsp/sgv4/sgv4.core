CAPI=2:
name: qick:dsp:sgv4:1.0.0
description: Signal generator v4 datapath 

filesets:
  hdl:
    files:
      - hdl/sgv4.sv
    file_type: systemVerilogSource
    depend:
      - qick:utils:delay_line
      - qick:dsp:ctrl_sgv4
      - qick:dsp:dds_compiler_0    # provides the DDS (model for sim, .xci for synth)
  tb:
    files:
      - tests/sgv4_tc00.sv
      - tests/sgv4_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/sgv4_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: sgv4
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: sgv4
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
