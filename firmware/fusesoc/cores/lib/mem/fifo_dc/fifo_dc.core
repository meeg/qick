CAPI=2:
name: qick:mem:fifo_dc:1.0.0
description: fifo_dc (mem library core).

filesets:
  hdl:
    files:
      - hdl/fifo_dc.sv
    file_type: systemVerilogSource
    depend:
      - qick:cdc:gcc
      - qick:mem:bram_tdp
  tb:
    files:
      - tests/fifo_dc_tc00.sv
      - tests/fifo_dc_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files:
          - tests/fifo_dc_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: fifo_dc
  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: fifo_dc
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]
  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
