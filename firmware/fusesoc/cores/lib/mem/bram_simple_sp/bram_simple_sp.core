CAPI=2:
name: qick:mem:bram_simple_sp:1.0.0
description: Simple single-port, one clock, read-first block RAM

filesets:
  hdl:
    files:
      - hdl/bram_simple_sp.sv
    file_type: systemVerilogSource

  tb:
    files: &tb_files
      - tests/bram_simple_sp_tc00.sv
      - tests/bin_memory_file.mem: {file_type: user,copyto: bin_memory_file.mem}
      - tests/tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend: 
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/bram_simple_sp_tc00.sv

targets:
  default: &default
    filesets:
      - hdl
      - lint_files

  lint:
    <<: *default
    default_tool: veriblelint
    toplevel: [bram_simple_sp]
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Run testbenches
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
