CAPI=2:
name: qick:utils:data_capture_ctrl:0.1.0
description: Simple data_capture_ctrl for interface management

filesets:
  hdl:
    files:
      - hdl/data_capture_ctrl.sv
    file_type: systemVerilogSource

  tb00:
    files: &tb_files
      - tests/data_capture_ctrl_tc00.sv
      - tests/tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend: 
      - qick:common:sim_base

  tb01:
    files:
      - tests/tb_data_capture_ctrl.sv
    file_type: systemVerilogSource
  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - tests/data_capture_ctrl_tc00.sv

targets:
  default: &default
    filesets: [hdl]

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: data_capture_ctrl
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Run testbenches
    filesets_append: [tb00]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-debug all -L XPM]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]

          #test:
          #  # Copy all key/value pairs from the "default" target.
          #  <<: *default
          #  description: Simulate the design
          #  default_tool: icarus
          #  filesets_append: [tb01]
          #  toplevel: tb
          #  tools:
          #    icarus:
          #      iverilog_options:
          #        - -g2012 # Use SystemVerilog-2012
          #    modelsim:
          #      vlog_options:
          #        - -timescale=1ns/1ns
