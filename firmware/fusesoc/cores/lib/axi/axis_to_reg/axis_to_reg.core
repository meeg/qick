CAPI=2:
name: qick:axi:axis_to_reg:1.0.0
description: Data writter from AXI-Stream to BRAM memory using a trigger

filesets:
  hdl:
    files:
      - hdl/axis_to_reg.sv
    file_type: systemVerilogSource
    depend:
      - qick:interfaces:axi4_stream_if

  tb:
    files:
      - test/axis_to_reg_tc00.sv
      - test/axis_to_reg_tests.sv: {is_include_file: true}
    file_type: systemVerilogSource
    depend:
      - qick:common:sim_base

  lint_files:
    depend:
      - qick:common:lint

generate:
  testrunner_gen:
    generator: svunit_gen
    parameters:
        test_files: 
          - test/axis_to_reg_tc00.sv

targets:
  default: &default
    filesets: [hdl]
    toplevel: axis_to_reg

  lint:
    <<: *default
    filesets_append: [lint_files]
    default_tool: veriblelint
    toplevel: axis_to_reg
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall]

  test:
    <<: *default
    description: Simulate the design
    filesets_append: [tb]
    default_tool: xsim
    generate: [testrunner_gen]
    toplevel: testrunner
    tools:
      xsim:
        xelab_options: [-timescale=1ns/1ns -debug all -L XPM -relax]
        xsim_options: [-testplusarg SVUNIT_FILTER="*" -onerror stop]
      modelsim:
        vlog_options: [-timescale=1ns/1ns -L xpm]              # XPM library
      icarus:
        iverilog_options:
          - -g2012 # Use SystemVerilog-2012

  synth:
    <<: *default
    description: Synthesize the design
    default_tool: vivado
    filesets_append:
      - pynq_z2
    tools:
      vivado:
        part: xc7z020clg400-1
        synth_options:
          - -include_dirs $XILINX_VIVADO/data/ip/xpm

    parameters:
      - B=16

parameters:
  B:
    datatype    : int
    description : data width in bits
    paramtype   : vlogparam
