CAPI=2:
name: qick:utils:xil_ip_gen:0.1.0
description: Xilinx IP generator utilities for QICK

generators:
  xil_ip_gen:
    interpreter: python3
    command: ip_generator.py
    description: Instantiate a Xilinx catalog IP and generate its .xci
    cache_type: input

  ip_packager:
    interpreter: python3
    command: ip_packager.py
    description: Package custom RTL into a Vivado IP (component.xml + xgui/)
    cache_type: none
