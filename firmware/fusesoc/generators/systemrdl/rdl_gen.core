CAPI=2:
name: qick:utils:rdl_gen:0.2.3

generators:
  rdl_gen:
    interpreter: python3
    command: rdl_gen.py
    description: Generate RTL and Python from SystemRDL files
    cache_type: input
    file_input_parameters: rdl_file
    usage: |
      Generates AXI4-Lite slave (SystemVerilog) and Python register package from .rdl files.

      Parameters:
          rdl_file (str): Path to .rdl file
          documentation (str): Generate html docs (html)
          headers (list): Types to generate (verilog, c, python)
          is_top (bool): Top-level instance flag (default: false)
